{
  "name": "city-compare",
  "private": true,
  "version": "0.1.0",
  "description": "Drag a city's real outline anywhere on the map and compare its true size, corrected for latitude.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "tsc --noEmit && node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings --test tests/*.test.ts",
    "zip": "node build.mjs --zip"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.12",
    "@types/node": "^22.0.0",
    "@types/webextension-polyfill": "^0.12.1",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.3"
  }
}
